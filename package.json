  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moldkey/dsh-plugin-mfgabc.git"
  },
  "homepage": "https://github.com/moldkey/dsh-plugin-mfgabc",
  "bugs": {
    "url": "https://github.com/moldkey/dsh-plugin-mfgabc/issues"
